[Unit]
Description=Notes Flask Application
After=network.target network-online.target
Wants=network-online.target

[Service]
User=notes
Group=notes
WorkingDirectory=/opt/notes
EnvironmentFile=/opt/notes/.env
ExecStart=/opt/notes/venv/bin/python app.py
Restart=always
RestartSec=5
StandardOutput=append:/opt/notes/app.log
StandardError=append:/opt/notes/app.log

# Security hardening
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/notes
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target